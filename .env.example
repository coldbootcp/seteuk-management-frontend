# 백엔드 API 오리진(경로 /api/v1은 클라이언트가 붙인다).
# 백엔드의 CORS_ORIGINS에 이 프론트엔드 오리진이 들어 있어야 한다.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 카카오 소셜 로그인 JS 키(선택). 없으면 로그인 화면에 카카오 버튼이 나오지 않고
# 이메일 로그인만 쓴다. 백엔드는 클라이언트가 받아온 access token만 검증하므로
# 이 키는 공개되어도 되는 JavaScript 키다(REST 키·시크릿이 아니다).
NEXT_PUBLIC_KAKAO_JS_KEY=

# 구글 소셜 로그인 OAuth 클라이언트 ID(선택, 카카오와 같은 원칙 — 없으면 버튼이
# 안 나온다). Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 클라이언트 ID"(유형: 웹 애플리케이션)를 만들고, 승인된 자바스크립트
# 원본에 이 프론트엔드 도메인을 등록해야 한다. client secret은 필요 없다 —
# 백엔드가 access token으로 구글 userinfo API를 직접 불러 검증한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
